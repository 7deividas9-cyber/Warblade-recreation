{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "Build Warblade",
            "command": "g++",
            "args": [
                "-g",
                "Warblade.cpp",
                "-I${env:HOME}/Apps/raylib-cpp/include",
                "-lraylib",
                "-lGL",
                "-lm",
                "-lpthread",
                "-ldl",
                "-lrt",
                "-lX11",
                "-o",
                "main"
            ],
            "windows": {
                "args": [
                    "-g",
                    "Warblade.cpp",
                    "-I${env:USERPROFILE}/Apps/raylib-cpp/include",
                    "-lraylib",
                    "-lopengl32",
                    "-lgdi32",
                    "-lwinmm",
                    "-o",
                    "main.exe"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "process",
            "label": "Run Warblade",
            "command": "${workspaceFolder}/main",
            "windows": {
                "command": "${workspaceFolder}/main.exe"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build Warblade",
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
